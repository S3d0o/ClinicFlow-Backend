# Copy to .env (git-ignored) and fill in. Read by docker-compose.yml.

# SQL Server SA password (min 8 chars, upper/lower/digit/symbol)
DB_PASSWORD=

# JWT signing key, at least 32 characters, unique per environment
JWT_SECRET=

# SMTP credentials (Gmail: use an app password)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Optional: creates the first admin on startup (no demo data in Production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

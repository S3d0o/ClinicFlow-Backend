# Copy to .env (git-ignored) and fill in. Read by docker-compose.yml.
# The V1 (master) and V2 (v2 branch) stacks read the same variable names. Each stack has its own SQL Server
# volume, so V2 never touches V1's data even when they share this file.

# SQL Server SA password (min 8 chars, upper/lower/digit/symbol). Used only by db and db-init
DB_PASSWORD=

# Password of the app's own login, clinicflow_v2_app in V2 (created by docker/db-init.sql; the backend
# no longer connects as sa). Same complexity rules as DB_PASSWORD, and no single quote (')
APP_DB_PASSWORD=

# JWT signing key, at least 32 characters, unique per environment
JWT_SECRET=

# SMTP credentials (Gmail: use an app password) and the address emails are sent from
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=

# Optional: creates the first admin on startup (no demo data in Production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local demos only: true loads the demo clinic (60 doctors, 80 patients, published passwords).
# Never set it on a real deployment.
SEED_DEMO_DATA=false
